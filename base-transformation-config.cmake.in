@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Core (header-only) targets.
include("${CMAKE_CURRENT_LIST_DIR}/base-transformation-targets.cmake")

# Re-find whatever plugin dependencies were enabled when the package was built.
if (@USE_EIGEN@)
  find_dependency(Eigen3)
endif()

if (@USE_PCL@)
  find_dependency(PCL COMPONENTS common)
endif()

# The 'plugins' component is available whenever at least one plugin was built.
if (@USE_EIGEN@ OR @USE_PCL@)
  set(base-transformation_plugins_FOUND TRUE)
endif()

check_required_components(base-transformation)
